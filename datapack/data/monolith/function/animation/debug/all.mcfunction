function monolith:animation/debug/spawn {x:0,z:5,block:"blue_concrete",easing:"out_quad"}
function monolith:animation/debug/spawn {x:3,z:5,block:"white_concrete",easing:"linear"}
function monolith:animation/debug/spawn {x:-3,z:8,block:"lime_concrete",easing:"in_cubic"}
function monolith:animation/debug/spawn {x:0,z:8,block:"green_concrete",easing:"out_cubic"}
function monolith:animation/debug/spawn {x:3,z:8,block:"yellow_concrete",easing:"in_out_quad"}
function monolith:animation/debug/spawn {x:-3,z:11,block:"orange_concrete",easing:"in_back"}
function monolith:animation/debug/spawn {x:0,z:11,block:"magenta_concrete",easing:"out_back"}
function monolith:animation/debug/spawn {x:3,z:11,block:"purple_concrete",easing:"in_out_cubic"}
function monolith:animation/debug/spawn {x:-3,z:14,block:"red_concrete",easing:"out_bounce"}
function monolith:animation/debug/spawn {x:0,z:14,block:"pink_concrete",easing:"in_bounce"}
function monolith:animation/debug/spawn {x:3,z:14,block:"cyan_concrete",easing:"in_out_back"}
function monolith:animation/debug/spawn {x:0,z:17,block:"black_concrete",easing:"in_out_bounce"}
